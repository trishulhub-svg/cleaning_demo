# ============================================================
# GreenLeaf Cleaning Services — Environment Variables
# Next.js + Turso (LibSQL) + Stripe + Nodemailer
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ============================================================

# ---------- App ----------
# Public URL of your app (used for Stripe callbacks, email links, etc.)
# On Vercel this is auto-set, but you can override it.
APP_URL=https://your-app-name.vercel.app

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=https://your-app-name.vercel.app

# ---------- Turso Database (LibSQL) ----------
TURSO_DB_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ---------- Stripe ----------
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
# Get from https://dashboard.stripe.com/webhooks (after creating a webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# ---------- Email (SMTP / Nodemailer) ----------
# Gmail example — use an App Password (not your real password).
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# Optional: customize the "From" header for outgoing emails
SMTP_FROM_NAME=GreenLeaf Cleaning
SMTP_FROM_EMAIL=your-email@gmail.com

# ---------- Node ----------
NODE_ENV=development
